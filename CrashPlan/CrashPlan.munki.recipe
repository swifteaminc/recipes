<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the latest CrashPlan agent installer for macOS and imports its signed package into Munki.</string>

	<key>Identifier</key>
	<string>com.github.swifteaminc.recipes.munki.crashplan</string>

	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>CrashPlan</string>
		<key>INSTALLER_NAME</key>
		<string>Install CrashPlan.pkg</string>
		<key>MUNKI_REPO_SUBDIR</key>
		<string>apps/%NAME%</string>
		<key>pkginfo</key>
		<dict>
			<key>blocking_applications</key>
			<array/>
			<key>catalogs</key>
			<array>
				<string>Backup</string>
				<string>Utilities</string>
			</array>
			<key>category</key>
			<string>Backup</string>
			<key>description</key>
			<string>CrashPlan provides continuous endpoint backup and recovery.</string>
			<key>developer</key>
			<string>CrashPlan Group, LLC</string>
			<key>display_name</key>
			<string>CrashPlan</string>
			<key>name</key>
			<string>%NAME%</string>
			<key>minimum_os_version</key>
			<string>14.0.0</string>
			<key>uninstallable</key>
			<true/>
			<key>uninstall_method</key>
			<string>uninstall_script</string>
			<key>uninstall_script</key>
			<string>#!/bin/zsh

UNINSTALLER="/Library/Application Support/CrashPlan/Uninstall.app/Contents/Resources/uninstall.sh"

if [[ ! -x "${UNINSTALLER}" ]]; then
	echo "CrashPlan uninstaller was not found at ${UNINSTALLER}" &gt;&amp;2
	exit 1
fi

/bin/zsh "${UNINSTALLER}"
exit $?</string>
			<key>unattended_install</key>
			<true/>
			<key>unattended_uninstall</key>
			<true/>
		</dict>
	</dict>

	<key>MinimumVersion</key>
	<string>2.7.2</string>

	<key>ParentRecipe</key>
	<string>com.github.swifteaminc.recipes.download.crashplan</string>

	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>PkgCopier</string>
			<key>Arguments</key>
			<dict>
				<key>source_pkg</key>
				<string>%pathname%/%INSTALLER_NAME%</string>
				<key>pkg_path</key>
				<string>%RECIPE_CACHE_DIR%/%NAME%.pkg</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>FlatPkgUnpacker</string>
			<key>Arguments</key>
			<dict>
				<key>flat_pkg_path</key>
				<string>%pkg_path%</string>
				<key>destination_path</key>
				<string>%RECIPE_CACHE_DIR%/pkg_metadata</string>
				<key>skip_payload</key>
				<true/>
				<key>purge_destination</key>
				<true/>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>URLTextSearcher</string>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>file://%RECIPE_CACHE_DIR%/pkg_metadata/Distribution</string>
				<key>re_pattern</key>
				<string>&lt;pkg-ref id="com\.crashplan\.app\.pkg" version="(?P&lt;version&gt;[0-9]+(?:\.[0-9]+)+)"</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>MunkiPkginfoMerger</string>
			<key>Arguments</key>
			<dict>
				<key>additional_pkginfo</key>
				<dict>
					<key>version</key>
					<string>%version%</string>
					<key>installs</key>
					<array>
						<dict>
							<key>CFBundleIdentifier</key>
							<string>com.crashplan.desktop</string>
							<key>CFBundleShortVersionString</key>
							<string>%version%</string>
							<key>path</key>
							<string>/Applications/CrashPlan.app</string>
							<key>type</key>
							<string>application</string>
							<key>version_comparison_key</key>
							<string>CFBundleShortVersionString</string>
						</dict>
					</array>
				</dict>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>MunkiImporter</string>
			<key>Arguments</key>
			<dict>
				<key>pkg_path</key>
				<string>%pkg_path%</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>PathDeleter</string>
			<key>Arguments</key>
			<dict>
				<key>path_list</key>
				<array>
					<string>%RECIPE_CACHE_DIR%/pkg_metadata</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the latest Google Chrome disk image and imports into Munki with correct version.</string>
    <key>Identifier</key>
    <string>com.github.swifteaminc.recipes.munki.google-chrome</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>GoogleChrome</string>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/%NAME%</string>
        <key>pkginfo</key>
        <dict>
            <key>catalogs</key>
            <array>
                <string>Browsers</string>
            </array>
            <key>category</key>
            <string>Internet &amp; Communication</string>
            <key>description</key>
            <string>Chrome is a fast, simple, and secure web browser, built for the modern web.</string>
            <key>developer</key>
            <string>Google</string>
            <key>display_name</key>
            <string>Google Chrome</string>
            <key>name</key>
            <string>%NAME%</string>
            <key>preinstall_script</key>
            <string>#!/bin/bash

if pgrep -xq -- "Google Chrome"; then
    exit 1
else
    exit 0
fi
            </string>
            <key>unattended_install</key>
            <true/>
        </dict>
    </dict>
    <key>MinimumVersion</key>
    <string>0.2.0</string>
    <key>ParentRecipe</key>
    <string>com.github.swifteaminc.recipes.download.google-chrome</string>
    <key>Process</key>
    <array>
        <!-- Merge the detected version into pkginfo -->
        <dict>
            <key>Processor</key>
            <string>MunkiPkginfoMerger</string>
            <key>Arguments</key>
            <dict>
                <key>additional_pkginfo</key>
                <dict>
                    <key>version</key>
                    <string>%version%</string>
                    <!-- Swif's agent runs Munki 6 with -installonly, which ignores
                         blocking apps, so an outdated Chrome that is open hit the
                         preinstall_script guard and failed on every cycle (ST-9143).
                         Report Chrome as installed while it is open; Munki updates
                         it on the next cycle where it is closed. -->
                    <key>installcheck_script</key>
                    <string>#!/bin/bash
# Munki: exit 0 = install needed, any other exit = installed.
app="/Applications/Google Chrome.app"
required="%version%"

installed=$(/usr/bin/defaults read "$app/Contents/Info" CFBundleShortVersionString 2>/dev/null) || exit 0
newest=$( { echo "$installed"; echo "$required"; } | /usr/bin/sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | /usr/bin/tail -1)
[ "$installed" = "$newest" ] &amp;&amp; exit 1

/usr/bin/pgrep -xq -- "Google Chrome" &amp;&amp; exit 1
exit 0
</string>
                </dict>
            </dict>
        </dict>

        <!-- Import DMG into Munki -->
        <dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pathname%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>

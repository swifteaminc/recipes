<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the latest stable release of MongoDB Compass and imports it into Munki.

For Apple Silicon, use DOWNLOAD_ARCH "arm64" and SUPPORTED_ARCH "arm64" (default).
For Intel, use DOWNLOAD_ARCH "x64" and SUPPORTED_ARCH "x86_64".</string>

	<key>Identifier</key>
	<string>com.github.swifteaminc.recipes.munki.mongodbcompass</string>

	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>MongoDBCompass</string>
		<key>DOWNLOAD_ARCH</key>
		<string>arm64</string>
		<key>SUPPORTED_ARCH</key>
		<string>arm64</string>
		<key>MUNKI_REPO_SUBDIR</key>
		<string>apps/%NAME%</string>
		<key>pkginfo</key>
		<dict>
			<key>catalogs</key>
			<array>
				<string>Developer Tools</string>
			</array>
			<key>category</key>
			<string>Developer Tools</string>
			<key>description</key>
			<string>MongoDB Compass is a graphical interface for querying, aggregating, and analyzing MongoDB data.</string>
			<key>developer</key>
			<string>MongoDB, Inc.</string>
			<key>display_name</key>
			<string>MongoDB Compass</string>
			<key>name</key>
			<string>%NAME%</string>
			<key>supported_architectures</key>
			<array>
				<string>%SUPPORTED_ARCH%</string>
			</array>
			<key>unattended_install</key>
			<true/>
			<key>unattended_uninstall</key>
			<true/>
		</dict>
	</dict>

	<key>MinimumVersion</key>
	<string>2.7.2</string>

	<key>ParentRecipe</key>
	<string>com.github.swifteaminc.recipes.download.mongodbcompass</string>

	<key>Process</key>
	<array>
		<dict>
			<key>Processor</key>
			<string>MunkiPkginfoMerger</string>
			<key>Arguments</key>
			<dict>
				<key>additional_pkginfo</key>
				<dict>
					<key>version</key>
					<string>%version%</string>
					<key>installs</key>
					<array>
						<dict>
							<key>CFBundleIdentifier</key>
							<string>com.mongodb.compass</string>
							<key>CFBundleShortVersionString</key>
							<string>%version%</string>
							<key>path</key>
							<string>/Applications/MongoDB Compass.app</string>
							<key>type</key>
							<string>application</string>
							<key>version_comparison_key</key>
							<string>CFBundleShortVersionString</string>
						</dict>
					</array>
				</dict>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>MunkiImporter</string>
			<key>Arguments</key>
			<dict>
				<key>pkg_path</key>
				<string>%pathname%</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>

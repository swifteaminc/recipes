<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Description</key>
  <string>Downloads the current macOS Harmony SASE (Perimeter 81) agent .pkg by reading the latest version from Check Point SASE agent release notes.</string>
  <key>Identifier</key>
  <string>com.github.swifteaminc.recipes.download.Perimeter81</string>

  <key>Input</key>
  <dict>
    <key>NAME</key><string>Perimeter81</string>
  </dict>

  <key>MinimumVersion</key><string>1.1</string>

  <key>Process</key>
  <array>
    <!-- Find the latest macOS 4-part version from the Check Point SASE Agent release notes landing page. -->
    <dict>
      <key>Processor</key><string>URLTextSearcher</string>
      <key>Arguments</key>
      <dict>
        <key>url</key>
        <string>https://sc1.checkpoint.com/documents/Infinity_Portal/WebAdminGuides/EN/SASE-Admin-Guide/SASE_Security/Topics/agent_release_notes/check_point_sase_agent.html</string>
        <key>re_pattern</key>
        <string>macOS release (?P&lt;full_version&gt;(?P&lt;version&gt;[0-9]+(?:\.[0-9]+){2})\.(?P&lt;build&gt;[0-9]+))</string>
        <key>result_output_var_name</key>
        <string>version</string>
      </dict>
    </dict>

    <!-- Download the exact version from the static CDN -->
    <dict>
      <key>Processor</key><string>URLDownloader</string>
      <key>Arguments</key>
      <dict>
        <key>url</key>
        <string>https://static.perimeter81.com/agents/mac/Harmony_SASE_%full_version%.pkg</string>
        <key>filename</key>
        <string>Harmony_SASE_%full_version%.pkg</string>
      </dict>
    </dict>

    <dict><key>Processor</key><string>EndOfCheckPhase</string></dict>

    <!-- Signature verify (respects -k DISABLE_CODE_SIGNATURE_VERIFICATION=true) -->
    <dict>
      <key>Processor</key><string>CodeSignatureVerifier</string>
      <key>Arguments</key>
      <dict>
        <key>input_path</key><string>%pathname%</string>
        <key>expected_authority_names</key>
        <array>
          <string>Developer ID Installer: Perimeter 81 LTD (924635PD62)</string>
          <string>Developer ID Certification Authority</string>
          <string>Apple Root CA</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
